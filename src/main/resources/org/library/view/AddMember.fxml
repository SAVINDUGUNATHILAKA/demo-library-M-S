<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.controller.AddMemberController">
   <children>
      <!-- Left: Registration Form Card -->
      <VBox prefWidth="440.0" spacing="16.0" styleClass="card" HBox.hgrow="NEVER">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="heading-3" text="Member Enrollment Form" />
                  <Label styleClass="text-muted" text="Register patron contact and residential profile for borrowing." />
               </children>
            </VBox>

            <!-- Member ID -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Member ID *" />
                  <TextField fx:id="txtMemberId" promptText="e.g. M106" />
               </children>
            </VBox>

            <!-- Full Name -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Full Name *" />
                  <TextField fx:id="txtName" promptText="e.g. Nimna Wickramasinghe" />
               </children>
            </VBox>

            <!-- Email Address -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Email Address *" />
                  <TextField fx:id="txtEmail" promptText="e.g. nimna@domain.com" />
               </children>
            </VBox>

            <!-- Phone Number -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Phone Number *" />
                  <TextField fx:id="txtPhone" promptText="e.g. 0771234567" />
               </children>
            </VBox>

            <!-- Address -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Address *" />
                  <TextArea fx:id="txtAddress" prefRowCount="3" promptText="Enter postal / residential address" wrapText="true" />
               </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Buttons -->
            <HBox spacing="10.0">
               <children>
                  <Button fx:id="btnRegister" defaultButton="true" maxWidth="Infinity" onAction="#handleRegister" prefHeight="40.0" styleClass="btn-primary" text="👤   Register Member" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnClear" cancelButton="true" onAction="#handleClear" prefHeight="40.0" prefWidth="90.0" styleClass="btn-secondary" text="Clear" />
               </children>
               <VBox.margin>
                  <Insets top="6.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>

      <!-- Right: Preview Table & Quick Nav -->
      <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="heading-3" text="Enrolled Members Directory" />
                        <Label styleClass="text-muted" text="Recent member registrations in the system" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnViewMembers" onAction="#handleViewAllMembers" styleClass="btn-secondary" text="👥   Manage All Members" />
               </children>
            </HBox>

            <TableView fx:id="tblMembersPreview" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colMemberId" prefWidth="90.0" text="Member ID" />
                  <TableColumn fx:id="colName" prefWidth="160.0" text="Full Name" />
                  <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email" />
                  <TableColumn fx:id="colPhone" prefWidth="120.0" text="Phone" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</HBox>
