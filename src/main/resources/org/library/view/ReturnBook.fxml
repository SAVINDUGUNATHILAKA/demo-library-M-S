<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="18.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.controller.ReturnBookController">
   <children>
      <!-- Left: Active Borrowed Books Table -->
      <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="heading-3" text="Active Borrowed Books" />
                  <Label styleClass="text-muted" text="Select an outstanding borrowed book from the list to process its return." />
               </children>
            </VBox>

            <!-- Search box -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 8px 12px; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px;">
               <children>
                  <Label style="-fx-font-size: 14px;" text="🔍" />
                  <TextField fx:id="txtSearchRecord" promptText="Filter by Member, Book Title, or Record ID..." style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <TableView fx:id="tblBorrowedBooks" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colRecordId" prefWidth="90.0" text="Record ID" />
                  <TableColumn fx:id="colMemberName" prefWidth="130.0" text="Member" />
                  <TableColumn fx:id="colBookTitle" prefWidth="170.0" text="Book Title" />
                  <TableColumn fx:id="colIssueDate" prefWidth="95.0" text="Issued" />
                  <TableColumn fx:id="colDueDate" prefWidth="95.0" text="Due Date" />
                  <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>

      <!-- Right: Return Processing & Overdue Calculation Card -->
      <VBox prefWidth="400.0" spacing="14.0" styleClass="card" HBox.hgrow="NEVER">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="heading-3" text="Process Book Return" />
                  <Label styleClass="text-muted" text="Verify loan details and calculate late fee." />
               </children>
            </VBox>

            <!-- Record ID Header Pill -->
            <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #f1f5f9; -fx-padding: 6px 10px; -fx-background-radius: 6px;">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;" text="TRANSACTION:" />
                  <Label fx:id="lblSelectedRecordId" style="-fx-font-weight: bold; -fx-text-fill: #2563eb;" text="None selected" />
               </children>
            </HBox>

            <!-- Member Info -->
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="form-label" text="Borrower Information" />
                  <HBox spacing="8.0">
                     <children>
                        <Label fx:id="lblMemberName" style="-fx-font-weight: 600; -fx-font-size: 13px;" text="-" />
                        <Label fx:id="lblMemberId" styleClass="text-muted" text="(-)" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Book Info -->
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="form-label" text="Book Information" />
                  <Label fx:id="lblBookTitle" style="-fx-font-weight: 600; -fx-font-size: 13px;" text="-" wrapText="true" />
                  <Label fx:id="lblBookId" styleClass="text-muted" text="(-)" />
               </children>
            </VBox>

            <Separator />

            <!-- Loan Dates Summary -->
            <HBox spacing="20.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="text-muted" text="Borrowed Date" />
                        <Label fx:id="lblBorrowedDate" style="-fx-font-weight: 600;" text="-" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="text-muted" text="Due Date" />
                        <Label fx:id="lblDueDate" style="-fx-font-weight: 600; -fx-text-fill: #b45309;" text="-" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Return Date Input -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Return Date *" />
                  <DatePicker fx:id="dpReturnDate" maxWidth="Infinity" promptText="Select Return Date" />
               </children>
            </VBox>

            <!-- Overdue Status & Fine Display Panel -->
            <VBox spacing="8.0" style="-fx-background-color: #fafbfd; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 12px;">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="OVERDUE ASSESSMENT" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label prefWidth="120.0" styleClass="text-muted" text="Status:" />
                        <Label fx:id="lblOverdueStatus" style="-fx-font-weight: bold;" text="-" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label prefWidth="120.0" styleClass="text-muted" text="Days Overdue:" />
                        <Label fx:id="lblOverdueDays" style="-fx-font-weight: 600;" text="0 days" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label prefWidth="120.0" styleClass="text-muted" text="Fine (\$0.50/day):" />
                        <Label fx:id="lblCalculatedFine" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #ef4444;" text="\$0.00" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Buttons -->
            <HBox spacing="10.0">
               <children>
                  <Button fx:id="btnReturnBook" defaultButton="true" disable="true" maxWidth="Infinity" onAction="#handleReturnBook" prefHeight="40.0" styleClass="btn-primary" text="🔄   Return Book" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnClear" onAction="#handleClear" prefHeight="40.0" prefWidth="80.0" styleClass="btn-secondary" text="Clear" />
               </children>
               <VBox.margin>
                  <Insets top="6.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
