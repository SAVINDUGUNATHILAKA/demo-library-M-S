<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.controller.ManageMembersController">
   <children>
      <!-- Top Action & Search Bar Card -->
      <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card-compact">
         <children>
            <Label style="-fx-font-size: 15px;" text="🔍" />
            <TextField fx:id="txtSearch" prefHeight="38.0" prefWidth="380.0" promptText="Search members by ID, name, phone, or email..." />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblMemberCount" style="-fx-font-weight: bold; -fx-text-fill: #2563eb; -fx-background-color: #dbeafe; -fx-background-radius: 6px; -fx-padding: 6px 12px;" text="Showing 0 Members" />
         </children>
      </HBox>

      <!-- Main Body: Table (Left) + Detail Edit Form (Right) -->
      <HBox spacing="18.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Members Table -->
            <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
               <children>
                  <TableView fx:id="tblMembers" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colMemberId" prefWidth="85.0" text="Member ID" />
                        <TableColumn fx:id="colName" prefWidth="150.0" text="Full Name" />
                        <TableColumn fx:id="colEmail" prefWidth="170.0" text="Email Address" />
                        <TableColumn fx:id="colPhone" prefWidth="110.0" text="Phone" />
                        <TableColumn fx:id="colAddress" prefWidth="160.0" text="Address" />
                        <TableColumn fx:id="colRegDate" prefWidth="100.0" text="Enrolled Date" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>

            <!-- Edit / Manage Panel -->
            <VBox prefWidth="360.0" spacing="14.0" styleClass="card" HBox.hgrow="NEVER">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label styleClass="heading-3" text="Edit Member Profile" />
                        <Label styleClass="text-muted" text="Select a member from the table to modify or delete their record." wrapText="true" />
                     </children>
                  </VBox>

                  <!-- Member ID (Read-only) -->
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Member ID (System Key)" />
                        <TextField fx:id="txtEditId" editable="false" opacity="0.8" promptText="Select a member" style="-fx-background-color: #f1f5f9;" />
                     </children>
                  </VBox>

                  <!-- Full Name -->
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Full Name *" />
                        <TextField fx:id="txtEditName" promptText="Member name" />
                     </children>
                  </VBox>

                  <!-- Email Address -->
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Email Address *" />
                        <TextField fx:id="txtEditEmail" promptText="Email address" />
                     </children>
                  </VBox>

                  <!-- Phone Number -->
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Phone Number *" />
                        <TextField fx:id="txtEditPhone" promptText="Phone number" />
                     </children>
                  </VBox>

                  <!-- Address -->
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="form-label" text="Address *" />
                        <TextArea fx:id="txtEditAddress" prefRowCount="3" promptText="Address" wrapText="true" />
                     </children>
                  </VBox>

                  <Region VBox.vgrow="ALWAYS" />

                  <!-- Action Buttons -->
                  <VBox spacing="10.0">
                     <children>
                        <Button fx:id="btnUpdate" maxWidth="Infinity" onAction="#handleUpdateMember" prefHeight="38.0" styleClass="btn-primary" text="💾   Update Details" />
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnDelete" maxWidth="Infinity" onAction="#handleDeleteMember" prefHeight="36.0" styleClass="btn-danger" text="🗑️   Delete Member" HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnCancelEdit" onAction="#handleCancelEdit" prefHeight="36.0" prefWidth="80.0" styleClass="btn-secondary" text="Cancel" />
                           </children>
                        </HBox>
                     </children>
                     <VBox.margin>
                        <Insets top="8.0" />
                     </VBox.margin>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
