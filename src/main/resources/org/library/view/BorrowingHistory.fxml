<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.controller.BorrowingHistoryController">
   <children>
      <!-- Filter Bar & Summary Counters -->
      <VBox spacing="12.0" styleClass="card-compact">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <!-- Search input -->
                  <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #ffffff; -fx-padding: 4px 10px; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 14px;" text="🔍" />
                        <TextField fx:id="txtSearch" promptText="Filter by Member ID, Member Name, Book Title, or Record ID..." style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <!-- Status Filter Dropdown -->
                  <ComboBox fx:id="cmbStatusFilter" prefWidth="180.0" promptText="Filter by Status" />

                  <!-- Reset Filters -->
                  <Button onAction="#handleResetFilter" prefHeight="36.0" styleClass="btn-secondary" text="Reset Filters" />
               </children>
            </HBox>

            <Separator />

            <!-- Quick Metric Summary Badges -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="6.0">
                     <children>
                        <Label styleClass="text-muted" text="Total Records:" />
                        <Label fx:id="lblTotalRecords" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="6.0">
                     <children>
                        <Label styleClass="text-muted" text="Currently Borrowed:" />
                        <Label fx:id="lblBorrowedCount" style="-fx-font-weight: bold; -fx-text-fill: #2563eb;" text="0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="6.0">
                     <children>
                        <Label styleClass="text-muted" text="Overdue Loans:" />
                        <Label fx:id="lblOverdueCount" style="-fx-font-weight: bold; -fx-text-fill: #ef4444;" text="0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="6.0">
                     <children>
                        <Label styleClass="text-muted" text="Completed Returns:" />
                        <Label fx:id="lblReturnedCount" style="-fx-font-weight: bold; -fx-text-fill: #10b981;" text="0" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- History Table View -->
      <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tblHistory" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colRecordId" prefWidth="95.0" text="Record ID" />
                  <TableColumn fx:id="colMemberId" prefWidth="85.0" text="Member ID" />
                  <TableColumn fx:id="colMemberName" prefWidth="150.0" text="Member Name" />
                  <TableColumn fx:id="colBookTitle" prefWidth="220.0" text="Book Title" />
                  <TableColumn fx:id="colIssueDate" prefWidth="95.0" text="Issue Date" />
                  <TableColumn fx:id="colDueDate" prefWidth="95.0" text="Due Date" />
                  <TableColumn fx:id="colReturnDate" prefWidth="110.0" text="Return Date" />
                  <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                  <TableColumn fx:id="colFine" prefWidth="85.0" text="Fine" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
