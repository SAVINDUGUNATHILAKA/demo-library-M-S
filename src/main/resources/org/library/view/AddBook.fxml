<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.library.controller.AddBookController">
   <children>
      <!-- Left: Add Book Form Card -->
      <VBox prefWidth="440.0" spacing="16.0" styleClass="card" HBox.hgrow="NEVER">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="heading-3" text="Book Information" />
                  <Label styleClass="text-muted" text="Enter complete bibliographic details to index in the library." />
               </children>
            </VBox>

            <!-- Book ID / ISBN -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Book ID / ISBN *" />
                  <TextField fx:id="txtBookId" promptText="e.g. B1007 or 978-0134685991" />
               </children>
            </VBox>

            <!-- Book Title -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Book Title *" />
                  <TextField fx:id="txtTitle" promptText="Enter full book title" />
               </children>
            </VBox>

            <!-- Author -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Author *" />
                  <TextField fx:id="txtAuthor" promptText="Author name (e.g. Joshua Bloch)" />
               </children>
            </VBox>

            <!-- Category -->
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="form-label" text="Category *" />
                  <ComboBox fx:id="cmbCategory" maxWidth="Infinity" promptText="Select Category" />
               </children>
            </VBox>

            <!-- Published Year & Quantity in a 2-column HBox -->
            <HBox spacing="14.0">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="form-label" text="Published Year *" />
                        <TextField fx:id="txtPublishedYear" promptText="e.g. 2024" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="form-label" text="Quantity *" />
                        <TextField fx:id="txtQuantity" promptText="e.g. 5" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Buttons: Add Book & Clear -->
            <HBox spacing="12.0">
               <children>
                  <Button fx:id="btnAddBook" defaultButton="true" maxWidth="Infinity" onAction="#handleAddBook" prefHeight="40.0" styleClass="btn-primary" text="➕   Add Book" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnClear" cancelButton="true" onAction="#handleClear" prefHeight="40.0" prefWidth="100.0" styleClass="btn-secondary" text="Clear" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>

      <!-- Right: Current Inventory Preview -->
      <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="heading-3" text="Catalog Preview" />
                  <Label styleClass="text-muted" text="Real-time listing of books indexed in the repository." />
               </children>
            </VBox>

            <TableView fx:id="tblBooksPreview" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colBookId" prefWidth="90.0" text="Book ID" />
                  <TableColumn fx:id="colTitle" prefWidth="180.0" text="Title" />
                  <TableColumn fx:id="colAuthor" prefWidth="130.0" text="Author" />
                  <TableColumn fx:id="colCategory" prefWidth="120.0" text="Category" />
                  <TableColumn fx:id="colQuantity" prefWidth="70.0" text="Qty" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</HBox>
